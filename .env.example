# Optional environment overrides. JobScout also reads the Anthropic key from a
# key.txt file in the project root or its parent, so you usually don't need this.

# Anthropic API key for extraction + match scoring.
# Resolution order: this env var -> key.txt (project root / parent). Without a
# key, JobScout falls back to a local heuristic scorer so the loop still runs.
ANTHROPIC_API_KEY=

# Overrides (defaults shown)
# JOBSCOUT_MODEL=claude-sonnet-5              # match-scoring model
# JOBSCOUT_EXTRACT_MODEL=claude-haiku-4-5-20251001  # Tier-3 page extraction
# JOBSCOUT_MAX_RUN_USD=30.00                  # LLM budget cap per run (safety brake;
#                                             #  a run only spends what its postings cost)
# JOBSCOUT_LLM_BATCH=8                        # postings per LLM request
# JOBSCOUT_DB=data/jobscout.db
# JOBSCOUT_SHORTLIST_MIN=45                   # min fit score to surface on the board
# JOBSCOUT_REC_MIN=20                         # LLM scores below this never become recommendations
# JOBSCOUT_VALIDATE=1                         # final Claude review of every New recommendation
# JOBSCOUT_WEB_IDLE_MINUTES=10                # dashboard exits after this many minutes
#                                             # without an open tab (0 = run forever)
# JOBSCOUT_QUEUE_MAX_DAYS=10                  # unscored postings retire after this many days
#                                             # (raise to ~21 while a backlog spans several
#                                             #  budget-capped runs)
# JOBSCOUT_VALIDATE_BATCH=10                  # recs per validation request
# JOBSCOUT_VALIDATE_MAX_REMOVAL=0.5           # discard a validation pass that removes more than this share
# JOBSCOUT_PREFILTER_KEEP=250                 # max postings/run sent to the LLM
# JOBSCOUT_PREFILTER_MIN=38                   # min prefilter score to reach the LLM
# JOBSCOUT_PER_COMPANY_CAP=12                 # max LLM-scored postings per company/run
# JOBSCOUT_REQUEST_DELAY=0.25                 # polite delay between feed requests
# JOBSCOUT_FETCH_WORKERS=8                    # companies fetched in parallel
# JOBSCOUT_INCLUDE_TRAINEE=false              # include trainee programmes?
